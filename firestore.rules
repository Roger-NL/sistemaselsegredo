rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownerCanUpdateUser() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly([
        "name",
        "email",
        "phone"
      ]) && (
        !affectedKeys.hasAny(["email"]) ||
        request.resource.data.email == request.auth.token.email
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Profiles and approval state are created by the verified server session.
      allow create: if isAdmin();
      allow update: if (isOwner(userId) && ownerCanUpdateUser()) || isAdmin();
      allow delete: if isAdmin();
    }

    match /pillar_exams/{examId} {
      allow create: if false;
      allow read: if (isSignedIn() && request.auth.uid == resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /live_sessions/{sessionId} {
      allow read: if isSignedIn() &&
        (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.studentId ||
          isAdmin()
        );
      allow read, write: if isAdmin();
    }

    match /access_requests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.currentPillar is int &&
        request.resource.data.requestedPillar is int &&
        request.resource.data.requestedPillar == request.resource.data.currentPillar + 1 &&
        request.resource.data.userName is string &&
        request.resource.data.userEmail is string &&
        request.resource.data.keys().hasOnly([
          "userId",
          "userName",
          "userEmail",
          "currentPillar",
          "requestedPillar",
          "status",
          "createdAt"
        ]);
      allow read: if (isSignedIn() && request.auth.uid == resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /invite_codes/{codeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payment_attempts/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhook_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
