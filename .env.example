# Firebase Admin emails provisioned through `npm run auth:admins -- --apply`.
FIREBASE_ADMIN_EMAILS=

# Closed beta: show only free access by invite on /pagamento.
# Keep this server-only; do not rename it with a NEXT_PUBLIC_ prefix.
BETA_FREE_MODE=true

# Asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# Development-only checkout used to test specialty purchases.
ASAAS_ENABLE_SPECIALTY_CHECKOUT=false

# Emergency preview override only. Never enable this in a real production release.
ASAAS_ALLOW_SANDBOX_IN_PRODUCTION=false

# Optional: application URL used when configuring webhooks/redirects manually
NEXT_PUBLIC_APP_URL=http://localhost:3000
