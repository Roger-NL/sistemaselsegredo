# The public demo runs locally without credentials. Never copy real values into git.
# Optional URL for future server integrations (not needed by the local story).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase browser SDK used by real account entry; the public story remains independent.
NEXT_PUBLIC_FIREBASE_API_KEY=example-only
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=example-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=example-only
NEXT_PUBLIC_FIREBASE_APP_ID=example-only
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Admin credential: a valid JSON service account supplied through environment settings.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_ADMIN_EMAILS=

# Reserved payments. Fail closed unless explicitly set to false for an authorized paid flow.
BETA_FREE_MODE=true
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=BasedSpeak/0.1
ASAAS_ENABLE_SPECIALTY_CHECKOUT=false
ASAAS_ALLOW_SANDBOX_IN_PRODUCTION=false

# Reserved Calendar. No calls from the demo.
GOOGLE_CALENDAR_SERVICE_ACCOUNT=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TUTOR_EMAIL=
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_CALENDAR_SLOT_DURATION_MINUTES=50
GOOGLE_CALENDAR_SLOT_GAP_MINUTES=10
GOOGLE_CALENDAR_WORKDAYS=1,2,3,4,5
GOOGLE_CALENDAR_WORKDAY_START_HOUR=9
GOOGLE_CALENDAR_WORKDAY_END_HOUR=18

# Server-only, on-click speech. Requires Firebase Admin above for the durable ledger.
# Blob stores immutable MP3s; never expire/delete speech_audio_cache_v3 attempt records.
# No default voice; all three values are required. Never use NEXT_PUBLIC_* for these.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BLOB_READ_WRITE_TOKEN=

# Fuso da agenda da aula gratuita (usa GOOGLE_CALENDAR_TIMEZONE se omitido).
# Agenda inicial: todos os dias, horários de uma hora, até dois meses à frente.
LIVE_CLASS_TIMEZONE=Europe/Lisbon
