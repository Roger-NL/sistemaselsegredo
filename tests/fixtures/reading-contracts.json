  "study": [
    {
      "id": "this-yours",
      "mode": "explain",
      "phrase": "Is this yours?",
      "meaning": "Esse café é seu?",
      "storyAudio": [
        {
          "id": "C01",
          "scope": "full"
        }
      ],
      "practice": {
        "kind": "choice",
        "options": [
          "Se você gosta do café.",
          "Se o copo é seu.",
          "Se você quer sair."
        ],
        "answer": "Se o copo é seu."
      }
    },
    {
      "id": "mine-your",
      "mode": "practice",
      "phrase": "Oh! This is mine.",
      "meaning": "Ah! Este é meu.",
      "storyAudio": [
        {
          "id": "C05",
          "scope": "full"
        }
      ],
      "practice": {
        "kind": "write",
        "answers": [
          "my mine your yours"
        ],
        "gaps": [
          {
            "before": "This is ",
            "after": " coffee.",
            "meaning": "Este é meu café.",
            "answers": [
              "my"
            ],
            "feedback": "Aqui, `coffee` vem depois da lacuna e a tradução diz ‘meu café’. Use a forma que acompanha o nome: `my coffee`."
          },
          {
            "before": "It is ",
            "after": ".",
            "meaning": "É meu.",
            "answers": [
              "mine"
            ],
            "feedback": "O nome `coffee` já ficou entendido. `Mine` representa ‘o meu café’ inteiro: `It is mine.` — É meu."
          },
          {
            "before": "Is this ",
            "after": " coffee?",
            "meaning": "Este é seu café?",
            "answers": [
              "your"
            ],
            "feedback": "A tradução diz ‘seu café’ e `coffee` vem depois da lacuna. Use a forma que acompanha o nome: `your coffee`."
          },
          {
            "before": "Is it ",
            "after": "?",
            "meaning": "É seu?",
            "answers": [
              "yours"
            ],
            "feedback": "A pergunta não repete `coffee`. `Yours` já representa ‘o seu café’: `Is it yours?` — É seu?"
          }
        ]
      }
    },
